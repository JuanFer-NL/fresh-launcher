# Copiá este archivo como keystore.properties (está en .gitignore) para firmar la versión release.
# Copy this file to keystore.properties (git-ignored) to sign release builds.
#
# keytool -genkeypair -v -keystore ~/keystores/fresh-launcher.jks -storetype PKCS12 \
#   -alias upload -keyalg RSA -keysize 4096 -validity 10000
storeFile=/absolute/path/to/fresh-launcher.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
